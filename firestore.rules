rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // חשבון אחד לכל העסק: מי שיודע את סיסמת העסק נכנס איתו. חשבונות אחרים נחסמים.
    function business() { return request.auth != null && request.auth.token.email == 'business@mishmish.app'; }
    match /areas/{id} { allow read, write: if business(); }
    match /drivers/{id} { allow read, write: if business(); }
    match /orders/{id} { allow read, write: if business(); }
    match /tokens/{id} { allow read, write: if business(); }
  }
}
